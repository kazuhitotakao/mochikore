LARAVEL_API_BASE_URL=http://backend:8000
# D-41：Laravelと共有する合言葉（backend/.env の NEXTJS_PROXY_KEY と同じ値）。値はコミットしない。NEXT_PUBLIC_ を付けない
NEXTJS_PROXY_KEY=
# D-119・F-35：共同編集の配信（Laravel Reverb）。ブラウザが WebSocket をつなぐ先。
# REVERB_APP_KEY は backend/.env と同じ値（公開してよい値だが、NEXT_PUBLIC_ は付けず Server Component から渡す）。
# 入れなければ、リアルタイムの表示なしで動く
REVERB_APP_KEY=
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8002
REVERB_PUBLIC_SCHEME=http
